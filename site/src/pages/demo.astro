---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { Code } from '@astrojs/starlight/components';
import { repo, runs, runUrl } from '../data/runs';

const duration = (s: number) => (s >= 60 ? `${Math.floor(s / 60)}m ${s % 60}s` : `${s}s`);

// Agent output from the first session, trimmed to one slot. Times are local (UTC+5:45).
// Long keys and lines elsewhere are shortened with an ellipsis.
const lifecycle = `$ selfaction agent start --repo broisnischal/selfaction --labels selfaction-local --slots 2
21:56:41 downloading actions/runner 2.338.2 (osx-arm64)
21:56:54 serving broisnischal/selfaction with 2 slot(s), labels self-hosted,macOS,ARM64,selfaction-local
21:56:58 macbook-pro-1-e9e696: online, waiting for a job
21:57:07 √ Connected to GitHub
21:57:12 Listening for Jobs
21:57:43 Running job: test
22:01:00 Job test completed with result: Succeeded
22:01:04 macbook-pro-1-be85a3: online, waiting for a job`;

const cacheRuns = `$ selfaction run          # first run: nothing cached yet
| Cache saved with key: deps-Linux-ae042401139c…
🏁  Job succeeded

$ selfaction run          # second run
| Cache restored from key: deps-Linux-ae042401139c…
| cache-hit=true
🏁  Job succeeded

$ selfaction cache ls
ID  REPO        KEY                          SIZE  CREATED        LAST USED
1   cache-demo  deps-Linux-ae042401139c…   253B  4 seconds ago  Less than a second ago`;

const stopping = `$ kill -INT <agent>          # same as Ctrl-C
agents still running: 0 (after 4s)
runners on GitHub: 0
runner containers: 0
listener processes: 0`;
---

<StarlightPage
	frontmatter={{
		title: 'Real runs',
		description: 'Jobs that GitHub sent to selfaction agents, with links to every run.',
		template: 'splash',
	}}
>
	<div class="not-content space-y-20 pb-16">
		<section aria-labelledby="runs">
			<p class="max-w-2xl text-lg leading-relaxed text-ink-soft">
				Everything on this page happened on{' '}
				<a href={repo} class="text-ink decoration-signal decoration-2 underline-offset-4">broisnees/selfaction</a>.
				Each run links to GitHub, where the full log is public. The account was called broisnischal when these
				runs happened, so the transcripts below show that name.
			</p>
			<h2 id="runs" class="mt-12 text-2xl font-bold tracking-[-0.015em] text-ink">Runs on the repository, newest first</h2>
			<ol class="mt-6 list-none divide-y divide-rule border-y border-rule p-0">
				{
					runs.map((r) => (
						<li class="grid grid-cols-1 gap-x-8 gap-y-2 py-6 md:grid-cols-[minmax(0,1fr)_9rem]">
							<div class="min-w-0">
								<p class="m-0 flex flex-wrap items-center gap-x-3 gap-y-1">
									<span
										class:list={['size-2.5 shrink-0 rounded-full', r.result === 'success' ? 'bg-pass' : 'bg-fail']}
										aria-hidden="true"
									/>
									<span class="font-semibold text-ink">{r.what}</span>
									<span class="text-sm text-ink-soft">{r.result === 'success' ? 'passed' : 'refused'}</span>
								</p>
								<p class="mt-2 font-mono text-[0.8rem] text-ink">{r.runner}</p>
								<p class="m-0 text-sm text-ink-soft">{r.machine}</p>
								<p class="mt-2 max-w-2xl leading-relaxed text-ink-soft">{r.note}</p>
							</div>
							<div class="md:text-right">
								<p class="m-0 text-2xl font-bold tabular-nums text-ink">{duration(r.seconds)}</p>
								<a href={runUrl(r.run)} class="text-sm text-ink-soft decoration-signal decoration-2 underline-offset-4 hover:text-ink">
									Run {r.run}
								</a>
							</div>
						</li>
					))
				}
			</ol>
		</section>

		<section aria-labelledby="lifecycle" class="grid grid-cols-1 items-start gap-10 lg:grid-cols-[minmax(0,0.75fr)_minmax(0,1.25fr)]">
			<div>
				<h2 id="lifecycle" class="text-2xl font-bold tracking-[-0.015em] text-ink">One slot, start to finish</h2>
				<p class="mt-3 leading-relaxed text-ink-soft">
					The agent downloads and verifies GitHub’s runner, registers a single-use runner, and waits. When the job ends,
					a new registration takes the slot four seconds later, under a new name.
				</p>
			</div>
			<div class="min-w-0"><Code code={lifecycle} lang="txt" frame="terminal" title="Agent output" /></div>
		</section>

		<section aria-labelledby="local" class="grid grid-cols-1 items-start gap-10 lg:grid-cols-[minmax(0,0.75fr)_minmax(0,1.25fr)]">
			<div>
				<h2 id="local" class="text-2xl font-bold tracking-[-0.015em] text-ink">A local run that remembers</h2>
				<p class="mt-3 leading-relaxed text-ink-soft">
					The repository’s cache demo, run twice with <code class="text-ink">selfaction run</code>. The first run saves
					the dependencies, and the second restores them and skips the install step. actions/cache v4, v5 and v6 all
					behaved the same way.
				</p>
			</div>
			<div class="min-w-0"><Code code={cacheRuns} lang="txt" frame="terminal" title="examples/cache-demo" /></div>
		</section>

		<section aria-labelledby="stop" class="grid grid-cols-1 items-start gap-10 lg:grid-cols-[minmax(0,0.75fr)_minmax(0,1.25fr)]">
			<div>
				<h2 id="stop" class="text-2xl font-bold tracking-[-0.015em] text-ink">Stopping leaves nothing behind</h2>
				<p class="mt-3 leading-relaxed text-ink-soft">
					After an interrupt, every runner has cancelled or finished, reported to GitHub and been unregistered. The
					first version of the agent took 32 seconds here and left two runners running.{' '}
					<a href="/blog/the-runner-that-would-not-stop/" class="text-ink decoration-signal decoration-2 underline-offset-4">Read what was wrong</a>.
				</p>
			</div>
			<div class="min-w-0"><Code code={stopping} lang="txt" frame="terminal" title="Terminal" /></div>
		</section>
	</div>
</StarlightPage>
