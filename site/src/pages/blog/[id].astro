---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { render } from 'astro:content';
import { posts, formatDate, minutes, type Post } from '../../lib/blog';

export async function getStaticPaths() {
	return (await posts()).map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props as { post: Post };
const { Content, headings } = await render(post);
---

<StarlightPage
	frontmatter={{ title: post.data.title, description: post.data.description }}
	headings={headings}
	hasSidebar={false}
>
	<p class="not-content text-sm text-ink-soft">
		<time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>, {minutes(post.body)} minute read
	</p>
	<Content />
	<p class="not-content mt-12 border-t border-rule pt-6">
		<a href="/blog/" class="font-semibold text-ink decoration-signal decoration-2 underline-offset-4">All posts</a>
	</p>
</StarlightPage>
